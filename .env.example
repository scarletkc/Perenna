# Perenna runtime inside the container
PERENNA_HOME=/data
PERENNA_SOURCE=chatgpt-web

# Required for the authenticated remote MCP endpoint
PERENNA_PUBLIC_URL=https://memory.example.com/mcp
PERENNA_OAUTH_ISSUER=https://your-tenant.example.com/
PERENNA_OAUTH_JWKS_URL=https://your-tenant.example.com/.well-known/jwks.json
PERENNA_OAUTH_ALLOWED_SUBJECT=replace-with-the-owner-sub

# Automatic Git push is disabled when this value is empty.
PERENNA_GIT_REMOTE=

# Configure the Vexor embedding provider as needed. Keep real keys only in the
# copied deployment environment file, never in this tracked example.
# VEXOR_CONFIG_JSON={"provider":"openai","model":"text-embedding-3-small"}
# VEXOR_API_KEY=replace-with-provider-key
